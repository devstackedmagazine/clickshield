# Vercel server-side secrets. Add these in Project Settings -> Environment
# Variables. Never rename them with a VITE_ prefix.
AI_OPENROUTER_API_KEY=
AI_GROQ_API_KEY=
AI_GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_WEB_RISK_API_KEY=

# Optional server configuration. Vercel's own deployment URL is allowed
# automatically. Use a comma-separated list for additional web origins.
APP_ORIGIN=
CLICKSHIELD_ALLOWED_ORIGINS=

# Optional provider model overrides. Comma-separate OpenRouter text models.
AI_OPENROUTER_TEXT_MODELS=
AI_OPENROUTER_VISION_MODEL=
AI_GROQ_MODEL=
AI_GEMINI_MODEL=

# Public configuration. These values are safe to include in the client bundle.
# Leave VITE_SCAN_API_URL empty for same-origin web builds; set it to the
# deployed Vercel origin when building the Android app.
VITE_SCAN_API_URL=
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LANGUAGE=sq
